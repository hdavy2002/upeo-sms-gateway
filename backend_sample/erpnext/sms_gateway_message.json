{
  "doctype": "DocType",
  "name": "SMS Gateway Message",
  "module": "Upeo Gateway",
  "custom": 1,
  "naming_rule": "Autoincrement",
  "fields": [
    { "fieldname": "device_id", "label": "Device ID", "fieldtype": "Data", "in_list_view": 1, "reqd": 1 },
    { "fieldname": "sender", "label": "Sender", "fieldtype": "Data", "in_list_view": 1, "reqd": 1 },
    { "fieldname": "message", "label": "Message", "fieldtype": "Long Text", "reqd": 1 },
    { "fieldname": "received_at", "label": "Received At", "fieldtype": "Data", "in_list_view": 1 },
    { "fieldname": "sim_slot", "label": "SIM Slot", "fieldtype": "Int" },
    { "fieldname": "message_hash", "label": "Message Hash", "fieldtype": "Data", "unique": 1, "reqd": 1 },
    { "fieldname": "status", "label": "Status", "fieldtype": "Select", "options": "received\nprocessed\nignored", "default": "received", "in_list_view": 1 },
    { "fieldname": "created_at", "label": "Created At", "fieldtype": "Datetime" }
  ],
  "permissions": [
    { "role": "System Manager", "read": 1, "write": 1, "create": 1, "delete": 1 }
  ]
}
